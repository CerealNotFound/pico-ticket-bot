# Pico settings
# ─────────────
# How to use this file:
#   1. Copy it:   cp .env.example .env
#   2. Fill in the values in .env (never in this file).
#   3. Check it:  uv run pico doctor
#
# .env holds your passwords/tokens. It is git-ignored, so it never gets committed.
# Lines starting with # are comments. Don't put quotes around values.


# ═══════════════════════════════════════════════════════════════════════
# PUMBLE  (where messages come in and where you approve tickets)
# ═══════════════════════════════════════════════════════════════════════
# Where to find these: Pumble → click your workspace name → Workspace settings
# → Configure apps → your app (e.g. "Pico"). You need to be a workspace admin.
#
# Your app needs:
#   - Socket mode: ON
#   - Bot scopes:  messages:read, messages:write, messages:edit, channels:read
#   - Events:      new_message
# If you change scopes AFTER installing the app, reinstall it and copy the NEW bot token.

# REQUIRED. The app's ID.
PUMBLE_APP_ID=

# REQUIRED. The app's key (Pumble may call it "App key").
PUMBLE_APP_KEY=

# REQUIRED. The bot's token, shown after you install the app.
PUMBLE_BOT_TOKEN=

# REQUIRED. The channel the bot listens to. Remember to add the bot to this channel.
# Easiest: right-click the channel in Pumble → Copy link, and paste the link here.
# You can also use just the channel name (without #), but that only works if the
# bot token has the channels:read scope.
PUMBLE_CHANNEL=tickets

# OPTIONAL. Who is allowed to approve or reject tickets.
# Leave empty to let anyone in the channel approve.
# To limit it, list Pumble user IDs separated by commas (no spaces needed).
PUMBLE_APPROVER_IDS=


# ═══════════════════════════════════════════════════════════════════════
# NOTION  (where the tickets get created)
# ═══════════════════════════════════════════════════════════════════════
# Setup:
#   1. Go to https://app.notion.com/developers/connections and create a new
#      internal connection called "Pico".
#   2. Give it these capabilities: Read content, Insert content, Read user information.
#   3. Open your board in Notion → ••• (top right) → Connections → add "Pico".
#      Without this step the bot can't see the board.

# REQUIRED. The connection's secret token. Starts with ntn_
NOTION_TOKEN=

# REQUIRED. Your board. Just paste the board's URL from the browser.
NOTION_DATABASE=

# OPTIONAL. A Notion page with your team's ticket rules (how to write titles,
# what priority means, etc.). The bot reads it before writing tickets.
# Paste the page URL, and share the page with "Pico" the same way as the board.
# Leave empty to use a local sop.md file instead (copy sop.example.md to start),
# or to use the built-in defaults if there is no sop.md either.
NOTION_SOP_PAGE=

# OPTIONAL. Which status column new tickets go into, e.g. Backlog or Not started.
# Must match a status that already exists on your board (same spelling).
# Leave empty to use the board's default status.
NOTION_DEFAULT_STATUS=

# OPTIONAL. true = the bot may invent new tags/labels on the board.
#           false = it only uses tags that already exist (recommended).
NOTION_ALLOW_NEW_LABELS=false

# OPTIONAL. The bot finds your board's columns by itself (Priority, Tags, Status,
# Assignee). Run `uv run pico doctor` to see what it picked. Only fill these in if it
# picked the wrong column or didn't find one. Use the exact column name from Notion.
NOTION_PROP_PRIORITY=
NOTION_PROP_LABELS=
NOTION_PROP_STATUS=
NOTION_PROP_ASSIGNEE=


# ═══════════════════════════════════════════════════════════════════════
# AI  (who writes the tickets)
# ═══════════════════════════════════════════════════════════════════════

# Which AI setup to use:
#   claude-cli = uses Claude Code that's logged in on this computer (your Claude
#                Pro/Max plan). No API key, no extra cost. Best for personal use.
#   anthropic  = uses the Anthropic API with an API key. Costs about 1-2 cents per
#                message. Best if your whole team posts in the channel.
LLM_BACKEND=claude-cli

# OPTIONAL. Which Claude model to use, e.g. claude-sonnet-5-5 or claude-opus-5-5.
# Leave empty for the default (Claude Code's default for claude-cli,
# claude-sonnet-5-5 for anthropic).
LLM_MODEL=

# ONLY needed when LLM_BACKEND=anthropic. Get a key at https://platform.claude.com
# With claude-cli this is ignored on purpose, so you're never billed by accident.
ANTHROPIC_API_KEY=


# ═══════════════════════════════════════════════════════════════════════
# TROUBLESHOOTING
# ═══════════════════════════════════════════════════════════════════════

# OPTIONAL. Set to 1 to print everything Pumble sends to the bot. Useful when
# something isn't reacting. Leave empty normally.
PICO_DEBUG=
